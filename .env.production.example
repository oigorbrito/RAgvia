# Copy to a secret-managed environment source. Do not commit populated values.
# Production must deploy one already-built application artifact by registry digest.
RPY_IMAGE=ghcr.io/oigorbrito/rpy@sha256:replace-with-64-hex-digest

POSTGRES_DB=rpy
POSTGRES_USER=rpy
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Database credentials are intentionally split by responsibility. Runtime services
# must never receive the migration/admin credential.
MIGRATION_DATABASE_URL=postgresql://rpy:replace-with-url-encoded-migration-password@postgres:5432/rpy
API_DATABASE_URL=postgresql://rpy_api:replace-with-url-encoded-api-password@postgres:5432/rpy
WORKER_DATABASE_URL=postgresql://rpy_worker:replace-with-url-encoded-worker-password@postgres:5432/rpy
SCHEDULER_DATABASE_URL=postgresql://rpy_scheduler:replace-with-url-encoded-scheduler-password@postgres:5432/rpy
BACKUP_DATABASE_URL=postgresql://rpy_backup:replace-with-url-encoded-backup-password@postgres:5432/rpy

ANTHROPIC_API_KEY=replace-with-anthropic-key

# Workers have no direct external route. HTTPS provider traffic must traverse the
# in-stack CONNECT gateway, which permits only these exact DNS hostnames on port 443.
# Keep this list minimal for the features actually enabled in the deployment.
# Default/legacy embedding requires api.openai.com. Add api.cohere.com only when
# Cohere embedding/reranking is authorized; add the configured DataJud/Langfuse
# hostname only when that integration is enabled; add lawsuits.production.judit.io
# when Judit attachment download is enabled.
EGRESS_PROXY_ALLOWED_HOSTS=api.anthropic.com,api.openai.com,requests.prod.judit.io,tracking.production.judit.io
EGRESS_PROXY_CONNECT_TIMEOUT_SECONDS=10

# Embedding rollout. false keeps the legacy OpenAI vector(1536) path and requires
# OPENAI_API_KEY. true activates exactly one provider/model-isolated 1024-dim runtime.
EMBEDDING_SPACE_RUNTIME_ENABLED=false
EMBEDDING_PROVIDER=bge

# Default/self-hosted provider. Before selecting bge, install the embeddings
# dependencies and mount/bake the model at this absolute container path.
BGE_EMBEDDING_MODEL=BAAI/bge-m3
BGE_EMBEDDING_PATH=/opt/rpy/models/bge-m3
BGE_EMBEDDING_DEVICE=
BGE_EMBEDDING_USE_FP16=false

# Optional external provider. Set EMBEDDING_PROVIDER=cohere only in an environment
# whose operator/data owner has explicitly authorized external embeddings. Secret
# process versions remain blocked from Cohere even when this deployment is authorized.
ALLOW_EXTERNAL_EMBEDDINGS=false
COHERE_EMBEDDING_MODEL=embed-v4.0
COHERE_API_KEY=

# Long-process reranking is disabled by default. BGE is the local/default provider.
# Production BGE activation requires the prepared artifact path below.
RERANKER_ENABLED=false
RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
BGE_RERANKER_PATH=/opt/rpy/models/bge-reranker-v2-m3
RERANKER_USE_FP16=false

# Cohere reranking is a separate external-data authorization from Cohere embeddings.
# Set RERANKER_PROVIDER=cohere only with explicit deployment approval.
ALLOW_EXTERNAL_RERANKER=false
COHERE_RERANKER_MODEL=rerank-v4.0-pro
RERANKER_TIMEOUT_SECONDS=15

# Legacy rollback only. May be left empty when EMBEDDING_SPACE_RUNTIME_ENABLED=true.
OPENAI_API_KEY=replace-with-openai-key
EMBEDDING_MODEL=text-embedding-3-small

# Outbound Judit requests use this provider credential. It is never exposed to browsers.
JUDIT_API_KEY=replace-with-judit-api-key
# Stable public HTTPS callback used by workers when creating Judit requests. The path token
# must match JUDIT_WEBHOOK_TOKEN below; keep the populated URL in the secret-managed source.
JUDIT_CALLBACK_URL=https://staging.example.invalid/webhooks/judit/replace-with-long-random-token
JUDIT_TIMEOUT_SECONDS=15
# Opt-in only: enables paid Judit attachment collection/download in workers.
JUDIT_ATTACHMENTS_ENABLED=false
JUDIT_ATTACHMENT_DOWNLOAD_MODE=

# Optional CNJ/DataJud metadata enrichment. Keep disabled until the target
# deployment has explicit legal/product authorization under the applicable
# DataJud terms. The key stays worker-only.
DATAJUD_ENABLED=false
DATAJUD_AUTHORIZED_USE=false
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_TIMEOUT_SECONDS=20

# Optional fail-open observability. Production image includes the pinned Langfuse
# v4 SDK, but tracing stays disabled until credentials/base URL are supplied.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=production

JUDIT_WEBHOOK_TOKEN=replace-with-long-random-token
JUDIT_WEBHOOK_MAX_BODY_BYTES=5242880
# Single-tenant deployments: processes ingested through the Judit webhook are
# bound to this tenant's authorized portfolio automatically. Leave unset to keep
# ingestion decoupled from authorization (populate tenant_processes explicitly).
JUDIT_WEBHOOK_TENANT_ID=
# Bulk/bootstrapping portfolio (optional). JSON mapping tenant UUID -> CNJ codes.
# Consumed by scripts/seed_carteira.py, and validated at API startup.
RPY_TENANT_PROCESSES={}
RPY_OPS_TOKEN=replace-with-long-random-ops-token
# Optional exact HTTPS browser origins allowed to call only process APIs.
# GitHub Pages project staging uses the origin only, without the /rpy path.
RPY_BROWSER_ORIGINS=

ANTHROPIC_TIMEOUT_SECONDS=15
EMBEDDING_TIMEOUT_SECONDS=15
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.25
# Deterministic character budgets applied before any external generation call.
PROVIDER_PROMPT_MAX_CHARS=120000
PROVIDER_STEP_TEXT_MAX_CHARS=12000
PROVIDER_STEPS_TEXT_MAX_CHARS=80000
WORKER_TASK_TIMEOUT_SECONDS=120
# Worker stops claiming immediately, but lets already-claimed jobs finish for this long.
WORKER_SHUTDOWN_GRACE_SECONDS=30
# Must remain greater than WORKER_SHUTDOWN_GRACE_SECONDS so Docker does not SIGKILL first.
WORKER_STOP_GRACE_PERIOD=40s

RETENTION_DAYS=365
JOB_RETENTION_DAYS=30

# Operational alert thresholds consumed by /ops/metrics. These do not affect /ready.
OPS_BACKUP_MAX_AGE_SECONDS=93600
OPS_QUEUE_WARN_SECONDS=300
OPS_QUEUE_CRITICAL_SECONDS=1800
OPS_STALE_PROCESSING_SECONDS=60
OPS_DEAD_JOBS_WARN_24H=1
OPS_DEAD_JOBS_CRITICAL_24H=5
OPS_GENERATION_P95_WARN_MS=60000
OPS_GENERATION_P95_CRITICAL_MS=120000

# Safe default for a same-host reverse proxy. Change only when the ingress topology requires it.
RPY_API_BIND_ADDRESS=127.0.0.1
RPY_API_PORT=8000
