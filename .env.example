# Local development defaults. This bearer maps to the synthetic local tenant
# used by the README quickstart; do not reuse these values outside local/dev.
# Set POSTGRES_PASSWORD to a newly generated URL-safe secret before starting Compose.
# Keep the current value unchanged when reusing an existing local database volume;
# changing this variable does not rotate the database role password.
JUDIT_WEBHOOK_TOKEN=dev-webhook-token
RPY_BEARER_TOKENS={"dev-local-token":"00000000-0000-0000-0000-000000000151"}
RPY_OPS_TOKEN=dev-ops-token
RETENTION_DAYS=365
JOB_RETENTION_DAYS=30

# Optional real-provider acceptance only; never commit populated values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
JUDIT_API_KEY=

# DataJud lookup is disabled unless authorized in writing. Credential is for workers only.
DATAJUD_ENABLED=false
DATAJUD_AUTHORIZED_USE=false
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_TIMEOUT_SECONDS=20
# Optional for local development; sensitive URL path contains JUDIT_WEBHOOK_TOKEN.
JUDIT_CALLBACK_URL=
JUDIT_TIMEOUT_SECONDS=15
# Paid/provider attachment collection is disabled unless both settings below are explicit.
JUDIT_ATTACHMENTS_ENABLED=false
JUDIT_ATTACHMENT_DOWNLOAD_MODE=

# Optional local OCR for already-authorized PNG/JPEG attachments.
# Disabled by default; requires a local Tesseract 5.x binary and language data.
ATTACHMENT_OCR_ENABLED=false
ATTACHMENT_OCR_BINARY=tesseract
ATTACHMENT_OCR_LANGUAGE=por
ATTACHMENT_OCR_TIMEOUT_SECONDS=30
ATTACHMENT_PDF_OCR_SCALE=2.0
ATTACHMENT_PDF_OCR_MAX_PAGES=100
EMBEDDING_MODEL=text-embedding-3-small
